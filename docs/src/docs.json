{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "appearance": {
    "default": "light",
    "strict": false
  },
  "name": "Notte",
  "colors": {
    "primary": "#00b85c",
    "light": "#00e673",
    "dark": "#00e673"
  },
  "logo": {
    "dark": "/logo/notte-mark-white.svg",
    "light": "/logo/notte-mark.svg"
  },
  "favicon": "/favicon.ico",
  "banner": {
    "content": "Supercharge your AI agents with the Notte CLI and MCP. [Use this quickstart prompt for AI.](/quickstart)",
    "dismissible": false
  },
  "seo.indexing": "all",
  "redirects": [
    {
      "source": "/integrations/mcp",
      "destination": "/mcp-server"
    },
    {
      "source": "/guides/vibe-coding",
      "destination": "/mcp-server"
    },
    {
      "source": "/guides/reliability",
      "destination": "/concepts/sessions"
    }
  ],
